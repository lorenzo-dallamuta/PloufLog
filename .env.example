# SSH Agent Configuration (automatically set by your shell)
SSH_AUTH_SOCK=/path/to/ssh/agent/socket
HOST_UID=1000
HOST_GID=1000

# Firebase Configuration
FIREBASE_PROJECT=demo-plouflog-dev
FIREBASE_KEY_PATH=./firebase-key.json

# Emulator Persistence Configuration
# WIPE_EMULATOR_DATA=true will start a clean database on next run
# WIPE_EMULATOR_DATA=false (default) will keep existing local data
WIPE_EMULATOR_DATA=false

